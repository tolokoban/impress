{
    "name": "@tolokoban/impress",
    "version": "0.13.0",
    "description": "Convert teaching markdown files into LibreOffice Impress presentations (.odp)",
    "type": "module",
    "bin": {
        "impress": "dist/impress.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "prebuild": "rm -rf dist",
        "build": "tsc",
        "check": "tsc --noEmit",
        "prepack": "npm run build",
        "pub": "npm publish --access public"
    },
    "engines": {
        "node": ">=20.15"
    },
    "keywords": [
        "markdown",
        "libreoffice",
        "impress",
        "odp",
        "presentation",
        "slides",
        "graphviz"
    ],
    "author": "Tolokoban",
    "license": "GPL-3.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tolokoban/impress.git"
    },
    "homepage": "https://github.com/tolokoban/impress#readme",
    "bugs": {
        "url": "https://github.com/tolokoban/impress/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "@types/node": "^24.19.2",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "sharp": "0.35.5"
    }
}
